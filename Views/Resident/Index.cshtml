@model IEnumerable<SmartSociety.Models.ResidentProfile>

@{
    ViewData["Title"] = "Residents";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Residents</h2>

        <a asp-action="Create" class="btn btn-primary">
            Add Resident
        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Full Name</th>
                <th>CNIC</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Block</th>
                <th>Flat</th>
                <th>Actions</th>
            </tr>
        </thead>


        <tbody>

            @foreach (var resident in Model)
            {
                <tr>

                    <td>
                        @resident.FullName
                    </td>

                    <td>
                        @resident.CNIC
                    </td>

                    <td>
                        @resident.ApplicationUser.Email
                    </td>

                    <td>
                        @resident.ApplicationUser.PhoneNumber
                    </td>

                    <td>
                        @resident.Flat.BlockName
                    </td>

                    <td>
                        @resident.Flat.FlatNumber
                    </td>

                    <td>

                        <a asp-action="Details"
                           asp-route-id="@resident.Id"
                           class="btn btn-sm btn-info">
                            Details
                        </a>


                        <a asp-action="Edit"
                           asp-route-id="@resident.Id"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>


                        <a asp-action="Delete"
                           asp-route-id="@resident.Id"
                           class="btn btn-sm btn-danger">
                            Delete
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>