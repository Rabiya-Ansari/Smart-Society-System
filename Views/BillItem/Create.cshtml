@model SmartSociety.Models.BillItem

@{
    ViewData["Title"] = "Add Bill Item";
}

<div class="container mt-4">
    <h1>Add Bill Item</h1>

    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="MaintenanceBillId" />

        <div class="form-group">
            <label asp-for="Description" class="control-label"></label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Amount" class="control-label"></label>
            <input asp-for="Amount" class="form-control" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Add Item</button>
        <a asp-controller="Maintenance" asp-action="Details" asp-route-id="@Model.MaintenanceBillId" class="btn btn-link btn-info">Back to Bill</a>
    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
