@model SmartSociety.Models.Flat

@{
    ViewData["Title"] = "Delete Flat";
}

<div class="container mt-4">

    <h2>Delete Flat</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this flat?
    </div>


    <div class="card">

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">
                    Block Name
                </dt>

                <dd class="col-sm-9">
                    @Model.BlockName
                </dd>


                <dt class="col-sm-3">
                    Flat Number
                </dt>

                <dd class="col-sm-9">
                    @Model.FlatNumber
                </dd>


                <dt class="col-sm-3">
                    Occupancy Type
                </dt>

                <dd class="col-sm-9">
                    @Model.OccupancyType
                </dd>


                <dt class="col-sm-3">
                    Status
                </dt>

                <dd class="col-sm-9">

                    @if (Model.IsOccupied)
                    {
                        <span class="badge bg-danger">
                            Occupied
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            Available
                        </span>
                    }

                </dd>

            </dl>


            <form asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />


                <button type="submit"
                        class="btn btn-danger">

                    Yes, Delete

                </button>


                <a asp-action="Index"
                   class="btn btn-primary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>