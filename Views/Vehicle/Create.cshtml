@model SmartSociety.Models.Vehicle

@{
    ViewData["Title"] = "Create Vehicle";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Create Vehicle</h1>

        <a asp-action="Index" class="btn btn-primary">
            Back to List
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                @* Admin selects resident *@
                @if (User.IsInRole("Admin"))
                {
                    <div class="form-group mb-3">

                        <label asp-for="ResidentProfileId"
                               class="control-label">
                        </label>

                        <select asp-for="ResidentProfileId"
                                class="form-control"
                                asp-items="@(ViewBag.Residents as IEnumerable<SelectListItem>)">

                            <option value="">
                                -- Select Resident --
                            </option>

                        </select>

                        <span asp-validation-for="ResidentProfileId"
                              class="text-danger">
                        </span>

                    </div>
                }
                else
                {
                    @* Resident ID is automatically assigned by controller *@

                    <input type="hidden"
                           asp-for="ResidentProfileId" />
                }


                <div class="form-group mb-3">

                    <label asp-for="RegistrationNumber"
                           class="control-label">
                    </label>

                    <input asp-for="RegistrationNumber"
                           class="form-control"
                           placeholder="e.g. ABC-123" />

                    <span asp-validation-for="RegistrationNumber"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-group mb-3">

                    <label asp-for="VehicleType"
                           class="control-label">
                    </label>

                    <input asp-for="VehicleType"
                           class="form-control"
                           placeholder="e.g. Car / Bike" />

                    <span asp-validation-for="VehicleType"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-group mb-3">

                    <label asp-for="Make"
                           class="control-label">
                    </label>

                    <input asp-for="Make"
                           class="form-control"
                           placeholder="e.g. Toyota" />

                    <span asp-validation-for="Make"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-group mb-3">

                    <label asp-for="Model"
                           class="control-label">
                    </label>

                    <input asp-for="Model"
                           class="form-control"
                           placeholder="e.g. Corolla" />

                    <span asp-validation-for="Model"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-group mb-3">

                    <label asp-for="Color"
                           class="control-label">
                    </label>

                    <input asp-for="Color"
                           class="form-control"
                           placeholder="e.g. White" />

                    <span asp-validation-for="Color"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-check mb-4">

                    <input asp-for="IsActive"
                           class="form-check-input" />

                    <label asp-for="IsActive"
                           class="form-check-label">
                    </label>

                </div>


                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">

                        Create Vehicle

                    </button>

                    <a asp-action="Index"
                       class="btn btn-primary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>
    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}