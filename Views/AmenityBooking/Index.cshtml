@model IEnumerable<SmartSociety.Models.AmenityBooking>

@{
    ViewData["Title"] = "Amenity Bookings";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Amenity Bookings</h2>
        <a asp-action="Create" class="btn btn-primary">New Booking</a>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

    <table class="table table-bordered table-striped">
        <thead>
            <tr><th>Amenity</th><th>Resident</th><th>Date</th><th>Time</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.Amenity.Name</td>
                    <td>@b.ResidentProfile.FullName</td>
                    <td>@b.BookingDate.ToShortDateString()</td>
                    <td>@b.StartTime - @b.EndTime</td>
                    <td>@b.Status</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Delete" asp-route-id="@b.Id" class="btn btn-sm btn-danger">Cancel</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
