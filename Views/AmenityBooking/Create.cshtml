@model SmartSociety.Models.AmenityBooking
@{ ViewData["Title"]="Create Booking"; var admin=User.IsInRole("Admin"); }
<div class="container mt-4"><div class="panel-card"><h1>Create Booking</h1><form asp-action="Create" method="post"><div asp-validation-summary="All" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="AmenityId" class="form-label"></label><select asp-for="AmenityId" class="form-select" asp-items="ViewBag.Amenities"><option value="">-- Select Amenity --</option></select><span asp-validation-for="AmenityId" class="text-danger"></span></div>
@if(admin){<div class="mb-3"><label asp-for="ResidentProfileId" class="form-label"></label><select asp-for="ResidentProfileId" class="form-select" asp-items="ViewBag.Residents"><option value="">-- Select Resident --</option></select><span asp-validation-for="ResidentProfileId" class="text-danger"></span></div>} else {<div class="alert alert-info">This booking will automatically be created for your resident profile.</div><input type="hidden" asp-for="ResidentProfileId" />}
<div class="row g-3"><div class="col-md-4"><label asp-for="BookingDate" class="form-label"></label><input asp-for="BookingDate" class="form-control" type="date"/><span asp-validation-for="BookingDate" class="text-danger"></span></div><div class="col-md-4"><label asp-for="StartTime" class="form-label"></label><input asp-for="StartTime" class="form-control" type="time"/><span asp-validation-for="StartTime" class="text-danger"></span></div><div class="col-md-4"><label asp-for="EndTime" class="form-label"></label><input asp-for="EndTime" class="form-control" type="time"/><span asp-validation-for="EndTime" class="text-danger"></span></div></div><div class="mt-3"><label asp-for="Remarks" class="form-label"></label><textarea asp-for="Remarks" class="form-control"></textarea><span asp-validation-for="Remarks" class="text-danger"></span></div><button class="btn btn-primary mt-4">Book</button><a asp-action="Index" class="btn mt-4 ms-2 btn-primary">Back</a></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
