@model SmartSociety.Models.EmergencyContact

@{
    ViewData["Title"] = "Delete Emergency Contact";
}

<div class="container mt-4">

    <h2>Delete Emergency Contact</h2>

    <div class="alert alert-danger">
        <strong>Are you sure?</strong> This action cannot be undone.
    </div>

    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Relationship</dt>
        <dd class="col-sm-9">@Model.Relationship</dd>

        <dt class="col-sm-3">Phone</dt>
        <dd class="col-sm-9">@Model.PhoneNumber</dd>

        <dt class="col-sm-3">Resident</dt>
        <dd class="col-sm-9">@Model.ResidentProfile.FullName</dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="Index" class="btn btn-primary">Cancel</a>
    </form>

</div>
