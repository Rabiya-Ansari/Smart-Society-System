@model IEnumerable<SmartSociety.Models.FamilyMember>

@{
    ViewData["Title"] = "Family Members";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Family Members</h2>

        <a asp-action="Create" class="btn btn-primary">Add Member</a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Relationship</th>
                <th>Date of Birth</th>
                <th>Resident</th>
                <th>Flat</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Relationship</td>
                    <td>@(item.DateOfBirth?.ToString("yyyy-MM-dd") ?? "-")</td>
                    <td>@item.ResidentProfile.FullName</td>
                    <td>@item.ResidentProfile.Flat.BlockName - @item.ResidentProfile.Flat.FlatNumber</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
