@model IEnumerable<SmartSociety.Models.Notice>

@{
    ViewData["Title"] = "Notices";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Notices</h2>
        @if (User.IsInRole("Admin")) { <a asp-action="Create" class="btn btn-primary">New Notice</a> }
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

    <table class="table table-bordered table-striped">
        <thead>
            <tr><th>Title</th><th>Publish</th><th>Expiry</th><th>Published</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var n in Model)
            {
                <tr>
                    <td>@n.Title</td>
                    <td>@n.PublishDate</td>
                    <td>@n.ExpiryDate</td>
                    <td>@(n.IsPublished ? "Yes" : "No")</td>
                    <td>
                        @if (User.IsInRole("Admin")) { <a asp-action="Edit" asp-route-id="@n.Id" class="btn btn-sm btn-warning">Edit</a> <a asp-action="Delete" asp-route-id="@n.Id" class="btn btn-sm btn-danger">Delete</a> }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
