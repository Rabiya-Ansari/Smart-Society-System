@model IEnumerable<SmartSociety.Models.GateLog>

@{
    ViewData["Title"] = "Gate Logs";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gate Logs</h2>
        <a asp-action="Create" class="btn btn-primary">Add Log</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Visitor</th>
                <th>Flat</th>
                <th>Security Guard</th>
                <th>Entry</th>
                <th>Exit</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Visitor.VisitorName</td>
                    <td>@item.Visitor.Flat.BlockName - @item.Visitor.Flat.FlatNumber</td>
                    <td>@item.SecurityGuard?.Email</td>
                    <td>@item.EntryTime</td>
                    <td>@(item.ExitTime?.ToString() ?? "-")</td>
                    <td>@item.Status</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
