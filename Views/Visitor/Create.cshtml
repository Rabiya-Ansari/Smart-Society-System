@model SmartSociety.Models.Visitor
@using Microsoft.AspNetCore.Mvc.Rendering
@{ ViewData["Title"]="Create Visitor"; var resident=User.IsInRole("Resident"); }
<div class="container mt-4"><div class="card shadow-sm"><div class="card-body p-4"><h1>Create Visitor</h1><p class="text-secondary">@if(resident){<text>Your visitor will be linked automatically to your flat and receive a secure pass.</text>}else{<text>Register a visitor for the selected flat.</text>}</p><form asp-action="Create" method="post"><div asp-validation-summary="All" class="text-danger mb-3"></div>
@if(!resident){<div class="mb-3"><label asp-for="FlatId" class="form-label"></label><select asp-for="FlatId" class="form-select" asp-items="@(ViewBag.Flats as IEnumerable<SelectListItem>)"><option value="">-- Select Flat --</option></select><span asp-validation-for="FlatId" class="text-danger"></span></div>} else {<input type="hidden" asp-for="FlatId" />}
<div class="mb-3"><label asp-for="VisitorName" class="form-label"></label><input asp-for="VisitorName" class="form-control" placeholder="e.g. Ali Ahmed"/><span asp-validation-for="VisitorName" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" placeholder="03001234567"/><span asp-validation-for="Phone" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="VehicleNumber" class="form-label"></label><input asp-for="VehicleNumber" class="form-control" placeholder="ABC-123"/><span asp-validation-for="VehicleNumber" class="text-danger"></span></div>
@if(!resident){<div class="mb-3"><label asp-for="GatePassCode" class="form-label"></label><input asp-for="GatePassCode" class="form-control" placeholder="6-digit code"/><span asp-validation-for="GatePassCode" class="text-danger"></span></div>} else {<input type="hidden" asp-for="GatePassCode" value="000000" />}
<div class="row g-3"><div class="col-md-6"><label asp-for="ValidFrom" class="form-label"></label><input asp-for="ValidFrom" class="form-control" type="datetime-local"/><span asp-validation-for="ValidFrom" class="text-danger"></span></div><div class="col-md-6"><label asp-for="ValidUntil" class="form-label"></label><input asp-for="ValidUntil" class="form-control" type="datetime-local"/><span asp-validation-for="ValidUntil" class="text-danger"></span></div></div>
@if(!resident){<div class="form-check mt-3"><input asp-for="IsApproved" class="form-check-input"/><label asp-for="IsApproved" class="form-check-label"></label></div>}
<div class="mt-4"><button type="submit" class="btn btn-primary">Create Visitor</button><a asp-action="Index" class="btn ms-2 btn-primary">Back</a></div></form></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
