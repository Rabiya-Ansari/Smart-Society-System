@model IEnumerable<SmartSociety.Models.Visitor>

@{
    ViewData["Title"] = "Visitors";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Visitors</h2>

        <a asp-action="Create" class="btn btn-primary">Add Visitor</a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Gate Pass</th>
                <th>Valid From</th>
                <th>Valid Until</th>
                <th>Flat</th>
                <th>Approved</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.VisitorName</td>
                    <td>@item.Phone</td>
                    <td>@item.GatePassCode</td>
                    <td>@item.ValidFrom</td>
                    <td>@item.ValidUntil</td>
                    <td>@item.Flat.BlockName - @item.Flat.FlatNumber</td>
                    <td>@(item.IsApproved ? "Yes" : "No")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
