@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    Func<string, string> navClass = ctrl => string.Equals(currentController, ctrl, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var displayName = User?.Identity?.Name ?? "User";
    var initials = displayName.Length > 0 ? displayName.Substring(0, 1).ToUpper() : "U";
    var roleLabel = User != null && User.IsInRole("Admin") ? "Administrator"
        : User != null && User.IsInRole("Resident") ? "Resident"
        : User != null && User.IsInRole("SecurityStaff") ? "Security Staff"
        : User != null && User.IsInRole("MaintenanceStaff") ? "Maintenance Staff"
        : "Member";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartSociety</title>
    <script>
        // Apply saved theme before first paint to avoid a light/dark flash.
        (function () {
            try {
                var saved = localStorage.getItem('ss-theme');
                var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                document.documentElement.setAttribute('data-theme', saved || (prefersDark ? 'dark' : 'light'));
            } catch (e) { }
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartSociety.styles.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-shell">
        <div class="sidebar-overlay" id="sidebarOverlay"></div>
        <aside class="sidebar" id="appSidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">S</span>
                <span>SmartSociety<span class="brand-sub">Community OS</span></span>
            </a>

            <div class="sidebar-user">
                <div class="user-avatar">@initials</div>
                <div>
                    <small>Signed in as</small>
                    <strong title="@displayName">@displayName</strong>
                    <span class="role-pill">@roleLabel</span>
                </div>
            </div>

            <nav class="side-nav">
                <a class="@(currentController == "Home" && currentAction != "Sitemap" ? "active" : "")" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>

                @if (User.IsInRole("Admin"))
                {
                    <div class="nav-heading">Community</div>
                    <a class="@navClass("Resident")" asp-controller="Resident" asp-action="Index"><i class="bi bi-people-fill"></i> Residents</a>
                    <a class="@navClass("Flat")" asp-controller="Flat" asp-action="Index"><i class="bi bi-building"></i> Flats</a>
                    <a class="@navClass("Vehicle")" asp-controller="Vehicle" asp-action="Index"><i class="bi bi-car-front-fill"></i> Vehicles</a>

                    <div class="nav-heading">Security Management</div>
                    <a class="@navClass("Security")" asp-controller="Security" asp-action="Index"><i class="bi bi-shield-fill-check"></i> Security Dashboard</a>
                    <a class="@(currentController == "Security" && currentAction == "VerifyPass" ? "active" : "")" asp-controller="Security" asp-action="VerifyPass"><i class="bi bi-qr-code-scan"></i> Visitor Verification</a>
                    <a class="@navClass("Visitor")" asp-controller="Visitor" asp-action="Index"><i class="bi bi-person-badge-fill"></i> Visitor Management</a>
                    <a class="@navClass("GateLog")" asp-controller="GateLog" asp-action="Index"><i class="bi bi-shield-lock-fill"></i> Gate Logs</a>

                    <div class="nav-heading">Operations</div>
                    <a class="@navClass("Amenity")" asp-controller="Amenity" asp-action="Index"><i class="bi bi-cup-hot-fill"></i> Amenities</a>
                    <a class="@navClass("AmenityBooking")" asp-controller="AmenityBooking" asp-action="Index"><i class="bi bi-calendar2-check-fill"></i> Bookings</a>
                    <a class="@navClass("Maintenance")" asp-controller="Maintenance" asp-action="Index"><i class="bi bi-receipt"></i> Maintenance Bills</a>
                    <a class="@navClass("Complaint")" asp-controller="Complaint" asp-action="Index"><i class="bi bi-tools"></i> Complaints</a>

                    <div class="nav-heading">Community Board</div>
                    <a class="@navClass("Notice")" asp-controller="Notice" asp-action="Index"><i class="bi bi-megaphone-fill"></i> Notices</a>
                    <a class="@navClass("Poll")" asp-controller="Poll" asp-action="Index"><i class="bi bi-bar-chart-fill"></i> Polls</a>
                    <a class="@navClass("AuditLog")" asp-controller="AuditLog" asp-action="Index"><i class="bi bi-journal-text"></i> Audit Logs</a>
                }

                @if (User.IsInRole("Resident"))
                {
                    <div class="nav-heading">My Society</div>
                    <a class="@navClass("Vehicle")" asp-controller="Vehicle" asp-action="Index"><i class="bi bi-car-front-fill"></i> My Vehicles</a>
                    <a class="@navClass("Visitor")" asp-controller="Visitor" asp-action="Index"><i class="bi bi-person-badge-fill"></i> My Visitors</a>
                    <a class="@navClass("Complaint")" asp-controller="Complaint" asp-action="Index"><i class="bi bi-tools"></i> My Complaints</a>
                    <a class="@navClass("Maintenance")" asp-controller="Maintenance" asp-action="Index"><i class="bi bi-receipt"></i> Bills & Payments</a>

                    <div class="nav-heading">Lifestyle</div>
                    <a class="@navClass("Amenity")" asp-controller="Amenity" asp-action="Index"><i class="bi bi-cup-hot-fill"></i> Amenities</a>
                    <a class="@navClass("AmenityBooking")" asp-controller="AmenityBooking" asp-action="Index"><i class="bi bi-calendar2-check-fill"></i> My Bookings</a>
                    <a class="@navClass("Notice")" asp-controller="Notice" asp-action="Index"><i class="bi bi-megaphone-fill"></i> Notices</a>
                    <a class="@navClass("Poll")" asp-controller="Poll" asp-action="Index"><i class="bi bi-bar-chart-fill"></i> Polls</a>

                    <div class="nav-heading">Household</div>
                    <a class="@navClass("EmergencyContact")" asp-controller="EmergencyContact" asp-action="Index"><i class="bi bi-telephone-fill"></i> Emergency Contacts</a>
                    <a class="@navClass("FamilyMember")" asp-controller="FamilyMember" asp-action="Index"><i class="bi bi-people-fill"></i> Family Members</a>
                }

                @if (User.IsInRole("SecurityStaff"))
                {
                    <div class="nav-heading">Gate Terminal</div>
                    <a class="@(currentController == "Security" && currentAction == "Index" ? "active" : "")" asp-controller="Security" asp-action="Index"><i class="bi bi-shield-fill-check"></i> Security Dashboard</a>
                    <a class="@(currentController == "Security" && currentAction == "VerifyPass" ? "active" : "")" asp-controller="Security" asp-action="VerifyPass"><i class="bi bi-qr-code-scan"></i> Verify Pass</a>
                    <a class="@navClass("Visitor")" asp-controller="Visitor" asp-action="Index"><i class="bi bi-person-badge-fill"></i> Visitors</a>
                    <a class="@navClass("GateLog")" asp-controller="GateLog" asp-action="Index"><i class="bi bi-journal-text"></i> Gate Logs</a>
                }

                @if (User.IsInRole("MaintenanceStaff"))
                {
                    <div class="nav-heading">Work Queue</div>
                    <a class="@navClass("Complaint")" asp-controller="Complaint" asp-action="Index"><i class="bi bi-tools"></i> Assigned Tickets</a>
                }
            </nav>

            <div class="sidebar-bottom">
                <a asp-controller="Home" asp-action="Sitemap"><i class="bi bi-diagram-3-fill"></i> Sitemap</a>
                <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" method="post">
                    <button type="submit" class="logout-btn"><i class="bi bi-box-arrow-right"></i> Logout</button>
                </form>
            </div>
        </aside>

        <main class="main-content">
            <div class="mobile-topbar">
                <button class="btn btn-outline-secondary" id="sidebarToggle" aria-label="Toggle menu"><i class="bi bi-list"></i></button>
                <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark" style="width:28px;height:28px;font-size:13px;">S</span> SmartSociety</a>
                <button type="button" class="theme-toggle" aria-label="Toggle dark mode" style="margin-left:auto;">
                    <i class="bi bi-moon-stars-fill"></i>
                    <i class="bi bi-sun-fill"></i>
                </button>
            </div>

            <div class="topbar">
                <h1 class="topbar-title">
                    <span>
                        <span class="eyebrow">@roleLabel Portal</span>
                        @ViewData["Title"]
                    </span>
                </h1>
                <div class="topbar-right">
                    <span class="topbar-clock"><i class="bi bi-shield-check text-primary"></i> Secure Session</span>
                    <button type="button" class="theme-toggle" aria-label="Toggle dark mode">
                        <i class="bi bi-moon-stars-fill"></i>
                        <i class="bi bi-sun-fill"></i>
                    </button>
                    <a asp-area="Identity" asp-page="/Account/Manage/Index" class="topbar-user-chip">
                        <span class="user-avatar">@initials</span>
                        <span>@displayName</span>
                        <i class="bi bi-chevron-down" style="font-size:11px;color:var(--muted);"></i>
                    </a>
                </div>
            </div>

            <div class="page-content">
                @RenderBody()
            </div>
        </main>
    </div>
}
else
{
    <main class="guest-content">
        @RenderBody()
    </main>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
