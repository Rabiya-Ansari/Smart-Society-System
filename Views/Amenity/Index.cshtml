@model IEnumerable<SmartSociety.Models.Amenity>

@{
    ViewData["Title"] = "Amenities";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Amenities</h2>
        <a asp-action="Create" class="btn btn-primary">Add Amenity</a>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <table class="table table-bordered table-striped">
        <thead>
            <tr><th>Name</th><th>Location</th><th>Capacity</th><th>Active</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.Name</td>
                    <td>@a.Location</td>
                    <td>@a.Capacity</td>
                    <td>@(a.IsActive ? "Yes" : "No")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@a.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
