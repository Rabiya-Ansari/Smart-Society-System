@model IEnumerable<SmartSociety.Models.AuditLog>
@{ ViewData["Title"]="Audit Logs"; int page=ViewBag.Page; int total=ViewBag.Total; int size=ViewBag.PageSize; int pages=(int)Math.Ceiling(total/(double)size); }
<div class="container-fluid py-4"><h1 class="fw-bold">Audit Logs</h1><div class="panel-card mb-4"><form method="get" class="row g-2"><div class="col-md-3"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search details/entity id" /></div><div class="col-md-2"><select name="actionType" class="form-select"><option value="">All actions</option>@foreach(var x in (IEnumerable<string>)ViewBag.Actions){<option value="@x" selected="@(ViewBag.ActionType==x)">@x</option>}</select></div><div class="col-md-2"><select name="entityName" class="form-select"><option value="">All entities</option>@foreach(var x in (IEnumerable<string>)ViewBag.Entities){<option value="@x" selected="@(ViewBag.EntityName==x)">@x</option>}</select></div><div class="col-md-2"><select name="userId" class="form-select"><option value="">All users</option>@foreach(var u in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Users){<option value="@u.Value" selected="@(ViewBag.UserId==u.Value)">@u.Text</option>}</select></div><div class="col-md-3 d-flex gap-2"><input type="date" name="startDate" value="@(ViewBag.StartDate is DateTime d1?d1.ToString("yyyy-MM-dd"):"")" class="form-control"/><input type="date" name="endDate" value="@(ViewBag.EndDate is DateTime d2?d2.ToString("yyyy-MM-dd"):"")" class="form-control"/><button class="btn btn-primary">Filter</button></div></form></div><div class="panel-card"><div class="table-responsive"><table class="table"><thead><tr><th>Timestamp</th><th>User</th><th>Action</th><th>Entity</th><th>Entity ID</th><th>Details</th><th>IP</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.Timestamp</td><td>@(a.ApplicationUser?.Email??a.ApplicationUserId)</td><td>@a.Action</td><td>@a.EntityName</td><td>@a.EntityId</td><td>@a.Details</td><td>@a.IpAddress</td></tr>}</tbody></table></div>@if(pages>1){<nav><ul class="pagination">@for(int i=1;i<=pages;i++){<li class="page-item @(i==page?"active":"")"><a class="page-link btn-primary" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search" asp-route-actionType="@ViewBag.ActionType" asp-route-entityName="@ViewBag.EntityName" asp-route-userId="@ViewBag.UserId">@i</a></li>}</ul></nav>}</div></div>
