@model SmartSociety.Models.Visitor
@{ ViewData["Title"]="Verify Gate Pass"; }
<div class="container py-5"><div class="row justify-content-center"><div class="col-lg-7"><div class="panel-card p-4"><span class="text-primary fw-semibold">SECURITY VERIFICATION</span><h1 class="fw-bold mb-3">Verify Visitor Pass</h1><form asp-action="VerifyPass" method="post"><div asp-validation-summary="All" class="text-danger mb-3"></div><label class="form-label">Gate Pass Code</label><input name="gatePassCode" class="form-control form-control-lg mb-4" placeholder="Enter 6-digit pass" autocomplete="off" autofocus /><div class="d-grid gap-2"><button name="actionType" value="Entry" class="btn btn-success btn-lg">Check In</button><button name="actionType" value="Exit" class="btn btn-outline-danger btn-lg">Check Out</button></div></form><a asp-action="Index" class="btn btn-link mt-3 btn-primary">Back to Dashboard</a></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
