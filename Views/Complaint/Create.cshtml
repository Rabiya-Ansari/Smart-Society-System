@model SmartSociety.Models.Complaint

@{
    ViewData["Title"] = "Create Complaint";
}

<div class="container mt-4">
    <h1>Create Complaint</h1>

    <form asp-action="Create" method="post">

        <div class="form-group">
            <label asp-for="ResidentProfileId" class="control-label"></label>
            <select asp-for="ResidentProfileId" class="form-control" asp-items="@(new SelectList(ViewBag.Residents, "Value", "Text"))">
                <option value="">-- Select Resident --</option>
            </select>
            <span asp-validation-for="ResidentProfileId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Category" class="control-label"></label>
            <select asp-for="Category" class="form-control" asp-items="ViewBag.Categories"></select>
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description" class="control-label"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Submit</button>
        <a asp-action="Index" class="btn btn-link">Back to List</a>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
