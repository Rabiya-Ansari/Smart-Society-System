@model SmartSociety.Models.Complaint
@using SmartSociety.Models.Enums
@{
    ViewData["Title"] = "Edit Complaint";
    var isAdmin = User.IsInRole("Admin");
    var isResident = User.IsInRole("Resident");
    var isStaff = User.IsInRole("MaintenanceStaff");
}
<div class="container mt-4">
    <h1>Edit Complaint</h1>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        @if (isAdmin) {
            <div class="mb-3"><label asp-for="ResidentProfileId" class="form-label"></label><select asp-for="ResidentProfileId" class="form-select" asp-items="@(new SelectList(ViewBag.Residents,"Value","Text"))"></select></div>
        }
        else { <input type="hidden" asp-for="ResidentProfileId" /> }
        <div class="mb-3"><label asp-for="Category" class="form-label"></label><select asp-for="Category" class="form-select" asp-items="ViewBag.Categories"></select><span asp-validation-for="Category" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="5"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
        @if (isAdmin || isStaff) {
            <div class="mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select" asp-items="ViewBag.Statuses"></select></div>
            <div class="mb-3"><label asp-for="WorkNotes" class="form-label"></label><textarea asp-for="WorkNotes" class="form-control" rows="4"></textarea><span asp-validation-for="WorkNotes" class="text-danger"></span></div>
        }
        @if (isAdmin) {
            <div class="mb-3"><label asp-for="AssignedStaffId" class="form-label"></label><select asp-for="AssignedStaffId" class="form-select" asp-items="@(new SelectList(ViewBag.Staff,"Value","Text"))"><option value="">-- Unassigned --</option></select></div>
            <div class="mb-3"><label asp-for="SlaTargetDate" class="form-label"></label><input asp-for="SlaTargetDate" class="form-control" type="datetime-local" /></div>
        }
        @if (isResident) { <div class="alert alert-info">Residents may edit the category and description while the complaint is Pending.</div> }
        @if (isStaff) { <div class="alert alert-info">Maintenance staff may update status to In Progress/Resolved and add work notes.</div> }
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
