@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="auth-shell">
    <div class="auth-visual">
        <div class="auth-visual-top">
            <a class="brand" href="/" style="color:#fff;">
                <span class="brand-mark">S</span>
                <span>SmartSociety<span class="brand-sub" style="color:#a5aede;">Community OS</span></span>
            </a>
        </div>
        <div class="auth-visual-mid">
            <span class="badge mb-3" style="background:rgba(139,92,246,.18);color:#c4b5fd;">JOIN THE COMMUNITY</span>
            <h2>Create your account and get started in minutes.</h2>
            <p>One account gives you access to visitor gate passes, complaint tracking, amenity bookings, digital bills and society announcements.</p>
            <ul class="auth-feature-list">
                <li><span class="ico"><i class="bi bi-patch-check-fill"></i></span> Free resident onboarding</li>
                <li><span class="ico"><i class="bi bi-lock-fill"></i></span> Encrypted account security</li>
                <li><span class="ico"><i class="bi bi-phone-fill"></i></span> Works on mobile & desktop</li>
                <li><span class="ico"><i class="bi bi-headset"></i></span> 24/7 helpdesk & support</li>
            </ul>
        </div>
        <div class="auth-visual-bottom">&copy; @DateTime.Now.Year SmartSociety &middot; Full-Stack Society Management Platform</div>
    </div>

    <div class="auth-form-side">
        <div class="auth-form-card">
            <h1>Create your account</h1>
            <p class="subtitle">It only takes a minute — you can add your flat & resident details after.</p>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email address</label>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3 password-wrap">
                    <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" id="regPasswordInput" />
                    <label asp-for="Input.Password">Password</label>
                    <button type="button" class="password-toggle" onclick="toggleAuthPassword('regPasswordInput', this)"><i class="bi bi-eye"></i></button>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3 password-wrap">
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" id="regConfirmPasswordInput" />
                    <label asp-for="Input.ConfirmPassword">Confirm password</label>
                    <button type="button" class="password-toggle" onclick="toggleAuthPassword('regConfirmPasswordInput', this)"><i class="bi bi-eye"></i></button>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-person-plus-fill"></i> Create account
                </button>

                <p class="auth-foot-link">
                    Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
                </p>
            </form>

            @{
                if ((Model.ExternalLogins?.Count ?? 0) != 0)
                {
                    <div class="auth-divider">or register with</div>
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div class="d-flex gap-2 flex-wrap justify-content-center">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn btn-outline-secondary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                            }
                        </div>
                    </form>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleAuthPassword(id, btn) {
            var el = document.getElementById(id);
            if (!el) return;
            var isPwd = el.type === 'password';
            el.type = isPwd ? 'text' : 'password';
            btn.innerHTML = isPwd ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
        }
    </script>
}
