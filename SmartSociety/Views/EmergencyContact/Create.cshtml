@model SmartSociety.Models.EmergencyContact

@{
    ViewData["Title"] = "Create Emergency Contact";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-body">

            <h2 class="mb-3">Create Emergency Contact</h2>

            <hr />

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- ============================= -->
                <!-- RESIDENT -->
                <!-- ============================= -->
                @if (User.IsInRole("Admin"))
                {
                    <div class="mb-3">

                        <label asp-for="ResidentProfileId"
                               class="form-label">
                            Resident
                        </label>

                        <select asp-for="ResidentProfileId"
                                class="form-control"
                                asp-items="ViewBag.Residents">

                            <option value="">
                                -- Select Resident --
                            </option>

                        </select>

                        <span asp-validation-for="ResidentProfileId"
                              class="text-danger">
                        </span>

                    </div>
                }
                else
                {
                    <!-- Resident ID controller automatically set karega -->

                    <input type="hidden"
                           asp-for="ResidentProfileId" />
                }


                <!-- ============================= -->
                <!-- NAME -->
                <!-- ============================= -->

                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label">
                        Name
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Enter emergency contact name" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>


                <!-- ============================= -->
                <!-- RELATIONSHIP -->
                <!-- ============================= -->

                <div class="mb-3">

                    <label asp-for="Relationship"
                           class="form-label">
                        Relationship
                    </label>

                    <input asp-for="Relationship"
                           class="form-control"
                           placeholder="e.g. Father, Mother, Brother" />

                    <span asp-validation-for="Relationship"
                          class="text-danger">
                    </span>

                </div>


                <!-- ============================= -->
                <!-- PHONE -->
                <!-- ============================= -->

                <div class="mb-3">

                    <label asp-for="PhoneNumber"
                           class="form-label">
                        Phone Number
                    </label>

                    <input asp-for="PhoneNumber"
                           class="form-control"
                           placeholder="03001234567"
                           maxlength="11" />

                    <span asp-validation-for="PhoneNumber"
                          class="text-danger">
                    </span>

                </div>


                <!-- ============================= -->
                <!-- BUTTONS -->
                <!-- ============================= -->

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">
                        Create
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary ms-2">
                        Back to List
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}