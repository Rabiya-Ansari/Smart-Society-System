@model SmartSociety.Models.Visitor

@{
    ViewData["Title"] = "Visitor Pass";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-xl-7 col-lg-8">

            <div class="card border-0 shadow-lg overflow-hidden"
                 style="border-radius: 24px;">

                <!-- Header -->
                <div class="p-4"
                     style="background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: white;">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="fw-bold"
                                      style="font-size: 28px;">
                                    S
                                </span>

                                <span class="fw-bold"
                                      style="font-size: 22px;">
                                    SmartSociety
                                </span>
                            </div>

                            <div class="small text-uppercase"
                                 style="letter-spacing: 2px; opacity: .85;">
                                Community OS
                            </div>
                        </div>

                        <div class="text-end">
                            <div class="small text-uppercase"
                                 style="letter-spacing: 1px;">
                                Visitor Pass
                            </div>

                            <div class="fw-bold">
                                @(Model.IsApproved ? "APPROVED" : "PENDING")
                            </div>
                        </div>

                    </div>

                </div>


                <!-- Body -->
                <div class="card-body p-4 p-md-5">

                    <div class="row g-4 align-items-center">

                        <!-- Visitor Information -->
                        <div class="col-md-7">

                            <div class="text-primary fw-semibold small mb-2">
                                VISITOR INFORMATION
                            </div>

                            <h2 class="fw-bold mb-4">
                                @Model.VisitorName
                            </h2>

                            <div class="mb-3">
                                <div class="text-muted small">
                                    PHONE
                                </div>

                                <div class="fw-semibold">
                                    @Model.Phone
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="text-muted small">
                                    FLAT
                                </div>

                                <div class="fw-semibold">
                                    @Model.Flat?.BlockName - @Model.Flat?.FlatNumber
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="text-muted small">
                                    GATE PASS
                                </div>

                                <div class="fw-bold fs-4"
                                     style="color: var(--primary);">
                                    @Model.GatePassCode
                                </div>
                            </div>

                            <div class="row">

                                <div class="col-6">
                                    <div class="text-muted small">
                                        VALID FROM
                                    </div>

                                    <div class="fw-semibold">
                                        @Model.ValidFrom.ToString("dd MMM yyyy")
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="text-muted small">
                                        VALID UNTIL
                                    </div>

                                    <div class="fw-semibold">
                                        @Model.ValidUntil.ToString("dd MMM yyyy")
                                    </div>
                                </div>

                            </div>

                        </div>


                        <!-- QR Code -->
                        <div class="col-md-5 text-center">

                            <div class="p-3 bg-white border rounded-4 d-inline-block">

                                <img src="data:image/png;base64,@ViewBag.QrCode"
                                     alt="Visitor Gate Pass QR Code"
                                     class="img-fluid"
                                     style="width: 190px; height: 190px;" />

                            </div>

                            <div class="small text-muted mt-3">
                                Scan to verify visitor
                            </div>

                        </div>

                    </div>


                    <!-- Status -->
                    <div class="mt-4 p-3 rounded-3"
                         style="background: var(--primary-soft);">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>
                                <div class="small text-muted">
                                    PASS STATUS
                                </div>

                                <div class="fw-bold">
                                    @(Model.IsApproved ? "Approved Visitor" : "Pending Approval")
                                </div>
                            </div>

                            <div class="fw-bold"
                                 style="color: var(--primary);">
                                #@Model.GatePassCode
                            </div>

                        </div>

                    </div>


                    <!-- Actions -->
                    <div class="d-flex gap-2 justify-content-center mt-4">

                        <button type="button"
                                onclick="window.print()"
                                class="btn btn-primary">
                            Print Pass
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Back
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<style>
    @@media print {

        body {
            background: white !important;
        }

        .top-guest-nav,
        .sidebar,
        .topbar,
        nav,
        footer {
            display: none !important;
        }

        .container {
            max-width: 100% !important;
            padding: 0 !important;
        }

        .card {
            box-shadow: none !important;
            border: 1px solid #ddd !important;
        }

        button,
        a {
            display: none !important;
        }
    }
</style>