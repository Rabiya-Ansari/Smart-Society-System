@{
    ViewData["Title"] = "Sitemap";
}

@if (!(User?.Identity?.IsAuthenticated ?? false))
{
    <div class="ss-hero-nav">

        <a class="ss-logo"
           asp-controller="Home"
           asp-action="Index">

            <span class="ss-logo-shield">
                <i class="bi bi-house-fill"></i>
            </span>

            <span class="ss-logo-text">
                <strong>
                    Smart<span>Society</span>
                </strong>

                <small>Management System</small>
            </span>

        </a>

        <div class="ss-nav-links">

            <a asp-controller="Home"
               asp-action="Index"
               class="active">
                Home
            </a>

            <a asp-controller="Home"
               asp-action="Index">
                About
            </a>

            <a asp-controller="Home"
               asp-action="Index">
                Services
            </a>

            <a asp-controller="Home"
               asp-action="Index">
                Features
            </a>

            <a asp-controller="Home"
               asp-action="Index">
                Contact
            </a>

            <a asp-area="Identity"
               asp-page="/Account/Login"
               class="ss-login-btn">

                <i class="bi bi-person-fill"></i>
                Login

            </a>

        </div>

    </div>
}

<div class="container py-4">

    <div class="text-center mb-4">
        <span class="text-primary fw-semibold">APPLICATION MAP</span>

        <h1 class="fw-bold">
            SmartSociety Sitemap
        </h1>

        <p class="text-secondary">
            Role-based navigation and major user journeys.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6">
            <div class="panel-card">
                <h4>Administrator</h4>
                <ul>
                    <li>Dashboard</li>
                    <li>Residents & Flats</li>
                    <li>Vehicles & Visitors</li>
                    <li>Gate Logs</li>
                    <li>Amenities & Bookings</li>
                    <li>Maintenance Bills & Payments</li>
                    <li>Complaints & Maintenance Assignment</li>
                    <li>Notices & Polls</li>
                    <li>Audit Logs</li>
                </ul>
            </div>
        </div>

        <div class="col-md-6">
            <div class="panel-card">
                <h4>Resident</h4>
                <ul>
                    <li>Dashboard & Profile</li>
                    <li>My Vehicles</li>
                    <li>My Visitors / Gate Passes</li>
                    <li>My Complaints</li>
                    <li>My Bills & Payments</li>
                    <li>Amenity Bookings</li>
                    <li>Notices & Polls</li>
                    <li>Emergency Contacts & Family</li>
                </ul>
            </div>
        </div>

        <div class="col-md-6">
            <div class="panel-card">
                <h4>Security Staff</h4>
                <ul>
                    <li>Security Dashboard</li>
                    <li>Visitor Verification</li>
                    <li>Today's Visitors</li>
                    <li>Active Gate Logs</li>
                </ul>
            </div>
        </div>

        <div class="col-md-6">
            <div class="panel-card">
                <h4>Maintenance Staff</h4>
                <ul>
                    <li>Assigned Complaints</li>
                    <li>Update Status</li>
                    <li>Work Notes</li>
                    <li>SLA visibility</li>
                </ul>
            </div>
        </div>

    </div>
</div>