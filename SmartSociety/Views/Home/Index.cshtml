@{
    ViewData["Title"] = "SmartSociety";
}



<div class="landing-page">

    <!-- ============================== HERO ============================== -->
    <section class="ss-hero" id="home">

        <!-- ================= NAVBAR ================= -->
        <div class="ss-hero-nav">

            <a class="ss-logo"
               asp-controller="Home"
               asp-action="Index">

                <span class="ss-logo-shield">
                    <i class="bi bi-house-fill"></i>
                </span>

                <span class="ss-logo-text">
                    <strong>
                        Smart<span>Society</span>
                    </strong>

                    <small>Management System</small>
                </span>

            </a>

            <div class="ss-nav-links">

                <a href="#home" class="active">
                    Home
                </a>

                <a asp-controller="Home"
                   asp-action="Index">
                    About
                </a>

                <a asp-controller="Home"
                   asp-action="Index">
                    Services
                </a>

                <a asp-controller="Home"
                   asp-action="Index">
                    Features
                </a>

                <a asp-controller="Home"
                   asp-action="Index">
                    Contact
                </a>

                

               

                <!-- Login -->
                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="ss-login-btn">

                    <i class="bi bi-person-fill"></i>
                    Login

                </a>

            </div>


        </div>


        <!-- ================= HERO OVERLAY ================= -->

        <div class="ss-hero-overlay"></div>


        <!-- ================= HERO CONTENT ================= -->

        <div class="ss-hero-content">

            <div class="ss-hero-left">

                <!-- Badge -->
                <div class="ss-eyebrow">

                    <i class="bi bi-shield-check"></i>

                    Smart · Secure · Connected

                </div>


                <!-- Heading -->
                <h1 class="ss-hero-title">

                    <span>Smart Society</span>

                    Management
                    <br />

                    System

                </h1>


                <!-- Line -->
                <div class="ss-hero-line">
                    <span></span>
                </div>


                <!-- Description -->
                <p class="ss-hero-description">

                    A complete digital platform to manage your
                    housing society efficiently, securely and
                    transparently.

                </p>


                <!-- CTA -->
                <div class="ss-hero-actions">

                    <a asp-area="Identity"
                       asp-page="/Account/Register"
                       class="ss-primary-btn">

                        <i class="bi bi-person-plus-fill"></i>

                        Get Started

                        <i class="bi bi-arrow-right"></i>

                    </a>


                    <a href="#features"
                       class="ss-secondary-btn">

                        <i class="bi bi-play-circle"></i>

                        Learn More

                    </a>

                </div>


                <!-- ================= STATS ================= -->

                <div class="ss-hero-stats">

                    <div class="ss-stat">

                        <div class="ss-stat-icon">
                            <i class="bi bi-shield-fill-check"></i>
                        </div>

                        <div>
                            <small>Secure</small>
                            <strong>100%</strong>
                        </div>

                    </div>


                    <div class="ss-stat-divider"></div>


                    <div class="ss-stat">

                        <div class="ss-stat-icon">
                            <i class="bi bi-people-fill"></i>
                        </div>

                        <div>
                            <small>Residents</small>
                            <strong>2500+</strong>
                        </div>

                    </div>


                    <div class="ss-stat-divider"></div>


                    <div class="ss-stat">

                        <div class="ss-stat-icon">
                            <i class="bi bi-buildings"></i>
                        </div>

                        <div>
                            <small>Facilities</small>
                            <strong>15+</strong>
                        </div>

                    </div>


                    <div class="ss-stat-divider"></div>


                    <div class="ss-stat">

                        <div class="ss-stat-icon">
                            <i class="bi bi-check-circle"></i>
                        </div>

                        <div>
                            <small>Support</small>
                            <strong>24/7</strong>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================= SECURITY BAR ================= -->

        <div class="ss-security-bar">

            <div class="ss-security-item">

                <div class="ss-security-icon">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>

                <div>
                    <strong>Secure Access</strong>
                    <span>Role-based security</span>
                </div>

            </div>


            <div class="ss-security-divider"></div>


            <div class="ss-security-item">

                <div class="ss-security-icon">
                    <i class="bi bi-grid-1x2-fill"></i>
                </div>

                <div>
                    <strong>Easy Management</strong>
                    <span>All-in-one dashboard</span>
                </div>

            </div>


            <div class="ss-security-divider"></div>


            <div class="ss-security-item">

                <div class="ss-security-icon">
                    <i class="bi bi-bell"></i>
                </div>

                <div>
                    <strong>Real-time Updates</strong>
                    <span>Instant notifications</span>
                </div>

            </div>


            <div class="ss-security-divider"></div>


            <div class="ss-security-item">

                <div class="ss-security-icon">
                    <i class="bi bi-people"></i>
                </div>

                <div>
                    <strong>Better Community</strong>
                    <span>Stronger connections</span>
                </div>

            </div>

        </div>

    </section>

    <section style="
        width:100%;
        padding:90px 7%;
        font-family:Arial, sans-serif;
        overflow:hidden;
        box-sizing:border-box;
        ">

        <div style="
            max-width:1200px;
            margin:0 auto;
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap:70px;
            flex-wrap:wrap;
            ">

            <!-- LEFT CONTENT -->
            <div style="
                flex:1;
                min-width:320px;
                ">

                <span style="
                    display:inline-block;
                    color:var(--primary);
                    font-size:14px;
                    font-weight:700;
                    letter-spacing:2px;
                    text-transform:uppercase;
                    margin-bottom:14px;
                    ">
                    About SmartSociety
                </span>

                <h2 style="
                    margin:0 0 20px;
                    color:var(--text-primary);
                    font-size:48px;
                    line-height:1.15;
                    font-weight:800;
                    ">
                    Smart Living.
                    <br>
                    <span style="color:var(--primary);">
                        Better Community.
                    </span>
                </h2>

                <p style="
                    color:var(--text-secondary);
                    font-size:17px;
                    line-height:1.8;
                    margin:0 0 18px;
                    max-width:600px;
                    ">
                    SmartSociety is a modern housing society management
                    platform designed to make community living smarter,
                    safer, and more convenient.
                </p>

                <p style="
                    color:var(--text-secondary);
                    font-size:16px;
                    line-height:1.8;
                    margin:0 0 30px;
                    max-width:600px;
                    ">
                    From visitor security and digital gate passes to
                    maintenance bills, complaints, amenity bookings and
                    community notices, SmartSociety brings essential
                    society services together in one simple platform.
                </p>


                <!-- FEATURES -->
                <div style="
                    display:grid;
                    grid-template-columns:repeat(2, minmax(150px, 1fr));
                    gap:16px;
                    margin-bottom:32px;
                    ">

                    <!-- Feature 1 -->
                    <div style="
                        background:var(--surface);
                        padding:18px;
                        border-radius:var(--radius);
                        border:1px solid var(--border);
                        box-shadow:var(--shadow-sm);
                        ">

                        <div style="
                            width:44px;
                            height:44px;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            background:var(--primary-soft);
                            color:var(--primary);
                            border-radius:10px;
                            font-size:20px;
                            margin-bottom:12px;
                            ">
                            🛡
                        </div>

                        <h4 style="
                            margin:0 0 6px;
                            color:var(--text-primary);
                            font-size:15px;
                            font-weight:700;
                            ">
                            Secure Community
                        </h4>

                        <p style="
                            margin:0;
                            color:var(--text-secondary);
                            font-size:13px;
                            line-height:1.5;
                            ">
                            Safe visitor and gate management.
                        </p>

                    </div>


                    <!-- Feature 2 -->
                    <div style="
                        background:var(--surface);
                        padding:18px;
                        border-radius:var(--radius);
                        border:1px solid var(--border);
                        box-shadow:var(--shadow-sm);
                        ">

                        <div style="
                            width:44px;
                            height:44px;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            background:var(--primary-soft);
                            color:var(--primary);
                            border-radius:10px;
                            font-size:20px;
                            margin-bottom:12px;
                            ">
                            💳
                        </div>

                        <h4 style="
                            margin:0 0 6px;
                            color:var(--text-primary);
                            font-size:15px;
                            font-weight:700;
                            ">
                            Easy Payments
                        </h4>

                        <p style="
                            margin:0;
                            color:var(--text-secondary);
                            font-size:13px;
                            line-height:1.5;
                            ">
                            Manage bills and payment records.
                        </p>

                    </div>


                    <!-- Feature 3 -->
                    <div style="
                        background:var(--surface);
                        padding:18px;
                        border-radius:var(--radius);
                        border:1px solid var(--border);
                        box-shadow:var(--shadow-sm);
                        ">

                        <div style="
                            width:44px;
                            height:44px;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            background:var(--primary-soft);
                            color:var(--primary);
                            border-radius:10px;
                            font-size:20px;
                            margin-bottom:12px;
                            ">
                            🔧
                        </div>

                        <h4 style="
                            margin:0 0 6px;
                            color:var(--text-primary);
                            font-size:15px;
                            font-weight:700;
                            ">
                            Easy Complaints
                        </h4>

                        <p style="
                            margin:0;
                            color:var(--text-secondary);
                            font-size:13px;
                            line-height:1.5;
                            ">
                            Report and track maintenance issues.
                        </p>

                    </div>


                    <!-- Feature 4 -->
                    <div style="
                        background:var(--surface);
                        padding:18px;
                        border-radius:var(--radius);
                        border:1px solid var(--border);
                        box-shadow:var(--shadow-sm);
                        ">

                        <div style="
                            width:44px;
                            height:44px;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            background:var(--primary-soft);
                            color:var(--primary);
                            border-radius:10px;
                            font-size:20px;
                            margin-bottom:12px;
                            ">
                            🏠
                        </div>

                        <h4 style="
                            margin:0 0 6px;
                            color:var(--text-primary);
                            font-size:15px;
                            font-weight:700;
                            ">
                            Community Living
                        </h4>

                        <p style="
                            margin:0;
                            color:var(--text-secondary);
                            font-size:13px;
                            line-height:1.5;
                            ">
                            Stay connected with your community.
                        </p>

                    </div>

                </div>


                <!-- BUTTON -->
                <a href="#features" style="
                    display:inline-flex;
                    align-items:center;
                    gap:10px;
                    padding:14px 25px;
                    background:var(--primary);
                    color:var(--white);
                    text-decoration:none;
                    border-radius:var(--radius);
                    font-size:15px;
                    font-weight:600;
                    box-shadow:var(--shadow);
                    transition:all .3s ease;
                    ">
                    Explore SmartSociety
                    <span style="font-size:18px;">→</span>
                </a>

            </div>


            <!-- RIGHT MOBILE MOCKUP -->
            <div style="
                flex:0 0 380px;
                min-width:300px;
                display:flex;
                justify-content:center;
                align-items:center;
                position:relative;
                ">

                <!-- Decorative Circle -->
                <div style="
                position:absolute;
                width:380px;
                height:380px;
                background:var(--primary-soft);
                border-radius:50%;
                z-index:0;
                "></div>


                <!-- MOBILE FRAME -->
                <div class="ss-phone-frame" style="
                    position:relative;
                    z-index:1;
                    width:290px;
                    padding:9px;
                    background:var(--black);
                    border-radius:36px;
                    box-shadow:var(--shadow-lg);
                    ">

                    <!-- Phone Top Speaker -->
                    <div style="
                    position:absolute;
                    top:17px;
                    left:50%;
                    transform:translateX(-50%);
                    width:80px;
                    height:20px;
                    background:var(--black);
                    border-radius:20px;
                    z-index:2;
                    "></div>

                    <img src="/images/about.png"
                         alt="SmartSociety Resident Dashboard"
                         style="
                    width:100%;
                    height:auto;
                    display:block;
                    border-radius:28px;
                    ">

                </div>

            </div>

        </div>


    </section>


    <section class="ss-features-section">

        <div class="ss-features-container">

            <div class="ss-features-header">
                <span>POWERFUL FEATURES</span>
                <h2>Everything You Need to Manage Your Society</h2>
                <p>
                    SmartSociety provides powerful digital tools to make society
                    management secure, organized, transparent and efficient.
                </p>
            </div>

            <div class="ss-features-grid">

                <div class="ss-feature-card">
                    <div class="ss-feature-number">01</div>
                    <div class="ss-feature-icon">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <h3>Secure Authentication</h3>
                    <p>
                        Secure login and role-based access ensure that every user
                        can access only the information relevant to their role.
                    </p>
                </div>

                <div class="ss-feature-card">
                    <div class="ss-feature-number">02</div>
                    <div class="ss-feature-icon">
                        <i class="bi bi-people"></i>
                    </div>
                    <h3>Role-Based Management</h3>
                    <p>
                        Dedicated dashboards and permissions for administrators,
                        residents, security guards and maintenance staff.
                    </p>
                </div>

                <div class="ss-feature-card">
                    <div class="ss-feature-number">03</div>
                    <div class="ss-feature-icon">
                        <i class="bi bi-qr-code"></i>
                    </div>
                    <h3>Digital Gate Pass</h3>
                    <p>
                        Generate and verify digital QR gate passes for visitors,
                        deliveries and other authorized entries.
                    </p>
                </div>

                <div class="ss-feature-card">
                    <div class="ss-feature-number">04</div>
                    <div class="ss-feature-icon">
                        <i class="bi bi-bell"></i>
                    </div>
                    <h3>Real-Time Notifications</h3>
                    <p>
                        Receive important visitor, complaint, booking and emergency
                        notifications without unnecessary delays.
                    </p>
                </div>

                <div class="ss-feature-card">
                    <div class="ss-feature-number">05</div>
                    <div class="ss-feature-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <h3>Activity & Audit Logs</h3>
                    <p>
                        Keep track of security entries, complaints, financial
                        changes and important administrative activities.
                    </p>
                </div>

                <div class="ss-feature-card">
                    <div class="ss-feature-number">06</div>
                    <div class="ss-feature-icon">
                        <i class="bi bi-phone"></i>
                    </div>
                    <h3>Responsive Design</h3>
                    <p>
                        Access SmartSociety comfortably from smartphones,
                        tablets, laptops and desktop computers.
                    </p>
                </div>

            </div>

        </div>

    </section>

    <!-- Services -->
    <section class="ss-services-section">

        <div class="ss-services-container">

            <!-- Section Header -->
            <div class="ss-services-header">
                <span class="ss-services-label">OUR SERVICES</span>

                <h2>
                    Smart Services for
                    <span>Smarter Communities</span>
                </h2>

                <p>
                    Everything your residential community needs to stay secure,
                    organized, connected and easy to manage.
                </p>
            </div>


            <!-- Services Grid -->
            <div class="ss-services-grid">

                <!-- Service 01 -->
                <div class="ss-service-card">

                    <div class="ss-service-top">
                        <div class="ss-service-icon">
                            <i class="bi bi-people"></i>
                        </div>

                        <span class="ss-service-number">01</span>
                    </div>

                    <h3>Resident Management</h3>

                    <p>
                        Manage resident, homeowner and tenant information,
                        flat details, vehicles and emergency contacts.
                    </p>

                    <a href="#" class="ss-service-link">
                        Learn More
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>


                <!-- Service 02 -->
                <div class="ss-service-card">

                    <div class="ss-service-top">
                        <div class="ss-service-icon">
                            <i class="bi bi-receipt"></i>
                        </div>

                        <span class="ss-service-number">02</span>
                    </div>

                    <h3>Maintenance Billing</h3>

                    <p>
                        View monthly maintenance invoices, outstanding dues,
                        payment history and detailed billing information.
                    </p>

                    <a href="#" class="ss-service-link">
                        Learn More
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>


                <!-- Service 03 -->
                <div class="ss-service-card">

                    <div class="ss-service-top">
                        <div class="ss-service-icon">
                            <i class="bi bi-qr-code-scan"></i>
                        </div>

                        <span class="ss-service-number">03</span>
                    </div>

                    <h3>Visitor Management</h3>

                    <p>
                        Create visitor passes and securely manage guests,
                        delivery riders and other authorized visitors.
                    </p>

                    <a href="#" class="ss-service-link">
                        Learn More
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>


                <!-- Service 04 -->
                <div class="ss-service-card">

                    <div class="ss-service-top">
                        <div class="ss-service-icon">
                            <i class="bi bi-tools"></i>
                        </div>

                        <span class="ss-service-number">04</span>
                    </div>

                    <h3>Complaint & Helpdesk</h3>

                    <p>
                        Submit maintenance complaints, upload photos and
                        track your request from pending to resolution.
                    </p>

                    <a href="#" class="ss-service-link">
                        Learn More
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>


                <!-- Service 05 -->
                <div class="ss-service-card">

                    <div class="ss-service-top">
                        <div class="ss-service-icon">
                            <i class="bi bi-calendar-check"></i>
                        </div>

                        <span class="ss-service-number">05</span>
                    </div>

                    <h3>Facility Booking</h3>

                    <p>
                        Check availability and reserve community facilities
                        such as clubhouses, sports courts and swimming pools.
                    </p>

                    <a href="#" class="ss-service-link">
                        Learn More
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>


                <!-- Service 06 -->
                <div class="ss-service-card">

                    <div class="ss-service-top">
                        <div class="ss-service-icon">
                            <i class="bi bi-megaphone"></i>
                        </div>

                        <span class="ss-service-number">06</span>
                    </div>

                    <h3>Notices & Announcements</h3>

                    <p>
                        Stay updated with society announcements, events,
                        important guidelines and emergency notices.
                    </p>

                    <a href="#" class="ss-service-link">
                        Learn More
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>


                <!-- Service 07 -->
                <div class="ss-service-card">

                    <div class="ss-service-top">
                        <div class="ss-service-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <span class="ss-service-number">07</span>
                    </div>

                    <h3>Gate Security</h3>

                    <p>
                        Verify visitor QR passes, record gate entries and
                        monitor visitor and vehicle activity in real time.
                    </p>

                    <a href="#" class="ss-service-link">
                        Learn More
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>


                <!-- Service 08 -->
                <div class="ss-service-card">

                    <div class="ss-service-top">
                        <div class="ss-service-icon">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>

                        <span class="ss-service-number">08</span>
                    </div>

                    <h3>Emergency Support</h3>

                    <p>
                        Quickly access emergency contacts, society guidelines
                        and important community alerts when needed.
                    </p>

                    <a href="#" class="ss-service-link">
                        Learn More
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

            </div>

        </div>

    </section>

    <!-- ============================== CTA BANNER ============================== -->
    <div class="hero-card p-5 mt-5  reveal text-center"
         style="
        position:relative;
        overflow:hidden;
        background:
        linear-gradient(
        135deg,
        var(--surface) 0%,
        var(--primary-light) 100%
        );
        border:1px solid var(--border);
        
        box-shadow:var(--shadow);
        transition:all .4s ease;
        "
         onmouseover="
        this.style.transform='translateY(-6px)';
        this.style.boxShadow='var(--shadow-lg)';
        "
         onmouseout="
        this.style.transform='translateY(0)';
        this.style.boxShadow='var(--shadow)';
        ">

        <!-- Decorative Animated Glow -->
        <div style="
        position:absolute;
        width:180px;
        height:180px;
        border-radius:50%;
        background:var(--primary);
        opacity:.08;
        filter:blur(45px);
        top:-90px;
        left:-50px;
        animation:ctaGlow 5s ease-in-out infinite alternate;
        "></div>

        <div style="
        position:absolute;
        width:160px;
        height:160px;
        border-radius:50%;
        background:var(--primary);
        opacity:.07;
        filter:blur(45px);
        bottom:-90px;
        right:-40px;
        animation:ctaGlow2 6s ease-in-out infinite alternate;
        "></div>


        <!-- Content -->
        <div style="position:relative;z-index:2;">

            <!-- Icon -->
            <div style="
                width:58px;
                height:58px;
                margin:0 auto 18px;
                display:flex;
                align-items:center;
                justify-content:center;
                border-radius:16px;
                background:var(--primary-soft);
                border:1px solid var(--border);
                color:var(--primary);
                font-size:25px;
                animation:ctaFloat 3s ease-in-out infinite;
                ">
                <i class="bi bi-buildings-fill"></i>
            </div>


            <h3 class="fw-bold mb-2"
                style="
                color:var(--text);
                font-size:28px;
                ">
                Ready to modernize your society?
            </h3>


            <p class="mb-4"
               style="
                color:var(--text-secondary);
                font-size:14px;
                max-width:600px;
                margin-left:auto;
                margin-right:auto;
                line-height:1.7;
                ">
                Create your account and start managing your community today.
            </p>


            <!-- Buttons -->
            <div class="d-flex gap-3 flex-wrap justify-content-center">

                <!-- Get Started -->
                <a asp-area="Identity"
                   asp-page="/Account/Register"
                   class="btn btn-primary btn-lg"
                   style="
                    border:none;
                    background:var(--primary);
                    color:var(--white);
                    border-radius:12px;
                    padding:12px 24px;
                    font-weight:600;
                    box-shadow:0 8px 20px rgba(138,63,5,.22);
                    transition:all .3s ease;
                    "
                   onmouseover="
                    this.style.background='var(--primary-dark)';
                    this.style.transform='translateY(-3px)';
                    this.style.boxShadow='0 12px 25px rgba(138,63,5,.30)';
                    "
                   onmouseout="
                    this.style.background='var(--primary)';
                    this.style.transform='translateY(0)';
                    this.style.boxShadow='0 8px 20px rgba(138,63,5,.22)';
                    ">

                    <i class="bi bi-person-plus-fill me-1"></i>
                    Get Started Free

                </a>


