@using SmartSociety.Models
@{ ViewData["Title"]="Security Dashboard"; var visitors=ViewBag.TodayVisitors as IEnumerable<Visitor> ?? Enumerable.Empty<Visitor>(); var logs=ViewBag.ActiveLogs as IEnumerable<GateLog> ?? Enumerable.Empty<GateLog>(); }
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2"><div><span class="text-primary fw-semibold"><i class="bi bi-shield-fill-check"></i> GATE TERMINAL</span><h1 class="fw-bold mb-0">Security Dashboard</h1></div><a asp-action="VerifyPass" class="btn btn-primary btn-lg"><i class="bi bi-qr-code-scan"></i> Verify Gate Pass</a></div>
<div class="row g-3 mb-4">
    <div class="col-md-6"><div class="stat-card tone-success"><div class="stat-top"><span class="stat-label">Approved Visitors Today</span><span class="stat-icon"><i class="bi bi-person-check-fill"></i></span></div><strong>@visitors.Count()</strong></div></div>
    <div class="col-md-6"><div class="stat-card tone-info"><div class="stat-top"><span class="stat-label">Visitors Currently Inside</span><span class="stat-icon"><i class="bi bi-door-open-fill"></i></span></div><strong>@logs.Count()</strong></div></div>
</div>
<div class="panel-card"><h4><i class="bi bi-person-badge-fill text-primary"></i> Active Visitors Inside</h4><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Visitor</th><th>Flat</th><th>Pass</th><th>Entry</th><th>Action</th></tr></thead><tbody>@foreach(var log in logs){<tr><td>@log.Visitor.VisitorName</td><td>@log.Visitor.Flat.BlockName - @log.Visitor.Flat.FlatNumber</td><td><code>@log.Visitor.GatePassCode</code></td><td>@log.EntryTime</td><td><a asp-action="VerifyPass" class="btn btn-sm btn-outline-primary">Check Out</a></td></tr>}</tbody></table></div></div>
