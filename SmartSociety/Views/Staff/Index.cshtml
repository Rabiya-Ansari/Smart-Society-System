@model IEnumerable<SmartSociety.Controllers.StaffController.StaffListItemViewModel>
@{
    ViewData["Title"] = "Staff Management";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Staff Management</h1>
    <div>
        <a asp-action="Create" class="btn btn-primary">Create Staff</a>
    </div>
</div>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Roles</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.FullName</td>
                    <td>@u.Email</td>
                    <td>@u.PhoneNumber</td>
                    <td>@string.Join(", ", u.Roles)</td>
                    <td>@(u.IsActive ? "Active" : "Inactive")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <form asp-action="Deactivate" method="post" style="display:inline-block" onsubmit="return confirm('Deactivate this staff?');">
                            <input type="hidden" name="id" value="@u.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
