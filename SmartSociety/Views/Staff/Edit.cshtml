@model SmartSociety.Controllers.StaffController.StaffEditViewModel
@{
    ViewData["Title"] = "Edit Staff";
}
<h1>Edit Staff</h1>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label">Full Name</label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" readonly />
    </div>
    <div class="mb-3">
        <label class="form-label">Phone</label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Role</label>
        <select asp-for="Role" class="form-select">
            <option value="">(none)</option>
            <option value="SecurityStaff" selected="@((Model.Role == "SecurityStaff") ? "selected" : null)">Security Staff</option>
            <option value="MaintenanceStaff" selected="@((Model.Role == "MaintenanceStaff") ? "selected" : null)">Maintenance Staff</option>
        </select>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label class="form-check-label">Active</label>
    </div>
    <button class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
