@model SmartSociety.Controllers.StaffController.StaffDetailsViewModel
@{
    ViewData["Title"] = "Staff Details";
}
<h1>Staff Details</h1>
<div class="card mb-3"><div class="card-body">
    <dl class="row">
        <dt class="col-sm-3">Full Name</dt><dd class="col-sm-9">@Model.FullName</dd>
        <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.PhoneNumber</dd>
        <dt class="col-sm-3">Roles</dt><dd class="col-sm-9">@string.Join(", ", Model.Roles)</dd>
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>
    </dl>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div></div>
