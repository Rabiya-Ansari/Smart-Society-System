@model SmartSociety.Models.Notice

@{
    ViewData["Title"] = "Delete Notice";
}

<div class="container mt-4">

    <h2>Delete Notice</h2>

    <div class="alert alert-danger">
        <strong>Are you sure?</strong> This action cannot be undone.
    </div>

    <dl class="row">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Publish Date</dt>
        <dd class="col-sm-9">@Model.PublishDate</dd>

        <dt class="col-sm-3">Expiry Date</dt>
        <dd class="col-sm-9">@Model.ExpiryDate</dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>

</div>
