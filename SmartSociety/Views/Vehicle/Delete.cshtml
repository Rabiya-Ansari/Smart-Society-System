@model SmartSociety.Models.Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";
}

<h1>Delete Vehicle</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">Registration Number</dt>
        <dd class="col-sm-10">@Model.RegistrationNumber</dd>

        <dt class="col-sm-2">Resident</dt>
        <dd class="col-sm-10">@Model.ResidentProfile?.FullName</dd>

        <dt class="col-sm-2">Flat</dt>
        <dd class="col-sm-10">@Model.ResidentProfile?.Flat?.BlockName - @Model.ResidentProfile?.Flat?.FlatNumber</dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-link">Back to List</a>
</form>
