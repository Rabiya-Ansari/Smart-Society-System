@model IEnumerable<SmartSociety.Models.GateLog>

@{
    ViewData["Title"] = "Gate Logs";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gate Logs</h2>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                Add Log
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Visitor</th>
                <th>Flat</th>
                <th>Security Guard</th>
                <th>Entry</th>
                <th>Exit</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>

                        <!-- Visitor -->
                        <td>
                            @(item.Visitor?.VisitorName ?? "Unknown Visitor")
                        </td>

                        <!-- Flat -->
                        <td>
                            @if (item.Visitor?.Flat != null)
                            {
                                @($"{item.Visitor.Flat.BlockName} - {item.Visitor.Flat.FlatNumber}")
                            }
                            else
                            {
                                <span class="text-muted">
                                    No Flat Assigned
                                </span>
                            }
                        </td>

                        <!-- Security Guard -->
                        <td>
                            @(item.SecurityGuard?.Email
                                ?? item.SecurityGuard?.UserName
                                ?? "Unknown Guard")
                        </td>

                        <!-- Entry -->
                        <td>
                            @item.EntryTime.ToString("dd-MM-yyyy hh:mm tt")
                        </td>

                        <!-- Exit -->
                        <td>
                            @if (item.ExitTime.HasValue)
                            {
                                @item.ExitTime.Value.ToString("dd-MM-yyyy hh:mm tt")
                            }
                            else
                            {
                                <span class="text-muted">Still Inside</span>
                            }
                        </td>

                        <!-- Status -->
                        <td>
                            @item.Status
                        </td>

                        <!-- Actions -->
                        <td>

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-info">
                                Details
                            </a>

                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-danger">
                                    Delete
                                </a>
                            }

                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">
                        No gate logs found.
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>