@model IEnumerable<SmartSociety.Models.MaintenanceBill>

@{
    ViewData["Title"] = "Maintenance Bills";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Maintenance Bills</h2>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create"
               class="btn btn-primary">
                Create Bill
            </a>
        }

    </div>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }


    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <!-- Bills Table -->
    <div class="table-responsive">

        <table class="table table-bordered table-striped align-middle">

            <thead>
                <tr>
                    <th>Flat</th>
                    <th>Billing Month</th>
                    <th>Amount Due</th>
                    <th>Penalty</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>


            <tbody>

                @if (Model != null && Model.Any())
                {
                    @foreach (var b in Model)
                    {
                        <tr>

                            <!-- Flat -->
                            <td>
                                @if (b.Flat != null)
                                {
                                    @($"{b.Flat.BlockName} - {b.Flat.FlatNumber}")
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Unknown Flat
                                    </span>
                                }
                            </td>


                            <!-- Billing Month -->
                            <td>
                                @b.BillingMonth.ToString("MMMM yyyy")
                            </td>


                            <!-- Amount Due -->
                            <td>
                                @b.AmountDue.ToString("N2")
                            </td>


                            <!-- Penalty -->
                            <td>
                                @b.PenaltyAmount.ToString("N2")
                            </td>


                            <!-- Due Date -->
                            <td>
                                @b.DueDate.ToString("dd-MM-yyyy")
                            </td>


                            <!-- Status -->
                            <td>

                                @if (b.PaymentStatus ==
                                    SmartSociety.Models.Enums.PaymentStatus.Paid)
                                {
                                    <span class="badge bg-success">
                                        Paid
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @b.PaymentStatus
                                    </span>
                                }

                            </td>


                            <!-- Actions -->
                            <td>

                                <!-- Details -->
                                <a asp-action="Details"
                                   asp-route-id="@b.Id"
                                   class="btn btn-sm btn-info">
                                    Details
                                </a>


                                <!-- Admin Actions -->
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@b.Id"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@b.Id"
                                       class="btn btn-sm btn-danger">
                                        Delete
                                    </a>
                                }


                                <!-- Resident Payment -->
                                @if (User.IsInRole("Resident") &&
                                    b.PaymentStatus !=
                                    SmartSociety.Models.Enums.PaymentStatus.Paid)
                                {
                                    <a asp-controller="Payment"
                                       asp-action="Create"
                                       asp-route-billId="@b.Id"
                                       class="btn btn-sm btn-success">
                                        Pay
                                    </a>
                                }

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7"
                            class="text-center text-muted">
                            No maintenance bills found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>