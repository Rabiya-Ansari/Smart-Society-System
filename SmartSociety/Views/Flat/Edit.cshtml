@model SmartSociety.Models.Flat

@{
    ViewData["Title"] = "Edit Flat";
}

<div class="container mt-4">

    <h2>Edit Flat</h2>

    <hr />

    <form asp-action="Edit" method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <!-- Block Name -->

        <div class="mb-3">

            <label asp-for="BlockName"
                   class="form-label">
            </label>

            <input asp-for="BlockName"
                   class="form-control" />

            <span asp-validation-for="BlockName"
                  class="text-danger">
            </span>

        </div>


        <!-- Flat Number -->

        <div class="mb-3">

            <label asp-for="FlatNumber"
                   class="form-label">
            </label>

            <input asp-for="FlatNumber"
                   class="form-control" />

            <span asp-validation-for="FlatNumber"
                  class="text-danger">
            </span>

        </div>


        <!-- Occupancy Type -->

        <div class="mb-3">

            <label asp-for="OccupancyType"
                   class="form-label">
            </label>

            <select asp-for="OccupancyType"
                    class="form-select"
                    asp-items="Html.GetEnumSelectList<SmartSociety.Models.Enums.OccupancyType>()">

                <option value="">
                    -- Select Occupancy Type --
                </option>

            </select>

            <span asp-validation-for="OccupancyType"
                  class="text-danger">
            </span>

        </div>


        <!-- Occupancy Status -->

        <div class="mb-3">

            <label class="form-label">
                Occupancy Status
            </label>

            <input class="form-control"
                   value="@(Model.IsOccupied ? "Occupied" : "Available")"
                   readonly />

            <div class="form-text">
                Occupancy status is managed automatically
                when a resident is assigned to the flat.
            </div>

        </div>


        <div class="mt-4">

            <button type="submit"
                    class="btn btn-primary">
                Update Flat
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}